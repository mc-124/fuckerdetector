CompileFlags:
  Remove:
    - "-f*"
    - "-m*"
    - "-fno-shrink-wrap"
    - "-fstrict-volatile-bitfields"
    - "-fno-tree-switch-conversion"
    - "-fzero-init-padding-bits=all"
    - "-fno-malloc-dce"
Documentation:
  CommentFormat: Doxygen
CompletionOptions:
  AllScopes: false
  IncludeIneligibleResults: false
Diagnostics:
  Suppress:
    - unused-includes
  UnusedIncludes: Disabled